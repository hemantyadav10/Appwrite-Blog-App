# Appwrite Configuration
VITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_PROJECT_ID=your_project_id_here
VITE_DATABASE_ID=your_database_id_here
VITE_BUCKET_ID_IMAGES=your_storage_bucket_id_here

# Collection IDs
VITE_COLLECTION_ID_USERS=your_users_collection_id_here
VITE_COLLECTION_ID_BLOGS=your_blogs_collection_id_here
VITE_COLLECTION_ID_SAVES=your_saves_collection_id_here
VITE_COLLECTION_ID_COMMENTS=your_comments_collection_id_here
VITE_COLLECTION_ID_LIKES=your_likes_collection_id_here

# TinyMCE Editor
VITE_EDITOR_API_KEY=your_tinymce_api_key_here

# Password Reset
VITE_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Application Base URL
VITE_BASE_URL=http://localhost:3000
